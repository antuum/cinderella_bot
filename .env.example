# Telegram Bot API token (get from @BotFather)
# IMPORTANT: Never commit your actual token. Use this file as template.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Your Telegram user ID to receive feedback (suggestions, comments) forwarded from users
# Get your ID via @userinfobot or from forwarded messages
# FEEDBACK_FORWARD_CHAT_ID=123456789
